# 默认保留本地规则对话，不会调用外部接口。
# 复制本文件为 .env.local；填写下面的 API Key 和模型 ID，并重启 Vite 后生效。
AGENT_PROVIDER=local

# 在此填写 OpenAI API Token / API Key。不要使用 VITE_ 前缀，也不要提交 .env.local。
OPENAI_API_KEY=

# 填写账号实际可用的 API 模型 ID（不是 ChatGPT 网页上的显示名称）。
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=20000

# Optional Cesium ion token intended for browser use.
VITE_CESIUM_ION_TOKEN=
